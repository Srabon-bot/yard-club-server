PORT=5000
# Canonical client HTTPS origin with no trailing slash. Must exactly match the
# client's BETTER_AUTH_URL and NEXT_PUBLIC_BETTER_AUTH_URL. JWT verification
# uses ${CLIENT_URL}/api/auth/jwks plus the same issuer/audience; mismatches
# cause 401s and sign-in/session reload failures.
CLIENT_URL=http://localhost:3000
# Optional comma-separated browser origins allowed by CORS. In production set
# this to the same canonical client origin as CLIENT_URL.
# CORS_ORIGINS=http://localhost:3000

# Preferred MongoDB connection string. When set it replaces the DB_* fallback
# values below. Use a placeholder here, never a real credential in this file.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
# Fallback used only when MONGODB_URI is unset.
DB_USER=your-mongodb-user
DB_PASSWORD=your-mongodb-password
DB_HOST=your-cluster.mongodb.net
DB_NAME=yardclubDB

# Stripe secret key, server-only. sk_test_... is for development and trials;
# use sk_live_... ONLY in a real production deployment accepting live payments.
STRIPE_SECRET_KEY=sk_test_replace-me
# Signing secret from `stripe listen` locally or the Stripe dashboard webhook.
STRIPE_WEBHOOK_SECRET=whsec_replace-me

# Optional: protects the /api/cron/booking-sweep endpoint when an external
# scheduler is used instead of the in-process cron.
# CRON_SECRET=replace-with-a-long-random-string
# Optional fallback for `npm run admin:promote`; prefer passing --email explicitly.
# ADMIN_EMAIL=admin@example.com
# Set to true to enable the hourly (UTC) in-process booking status sweep.
# ENABLE_BOOKING_CRON=false
# Five-field cron expression; defaults to "0 * * * *".
# BOOKING_CRON_SCHEDULE=0 * * * *
# Set to true to email the customer and owner when a booking completes.
# ENABLE_EMAIL_NOTIFICATIONS=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# EMAIL_FROM=Yardclub <no-reply@yardclub.test>
# Local preview only: print messages as JSON instead of sending SMTP.
# EMAIL_TRANSPORT=json
