{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": { "maxDuration": 15 }
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.ts" }
  ],
  "crons": [
    {
      "path": "/api/cron/booking-sweep",
      "schedule": "0 0 * * *"
    }
  ]
}
